FILEBASE_TOKEN_KLEROS=
FILEBASE_TOKEN_KLEROS_V2=
FILEBASE_TOKEN_KLEROS_WEBSITES=
FILEBASE_TOKEN_POH_V2=
FILEBASE_TOKEN_CURATE_V2=
FILEBASE_TOKEN_ESCROW_V2=
FILEBASE_TOKEN_REALITY_V2=
FILEBASE_TOKEN_KLEROS_TOKEN_LIST=
FILEBASE_TOKEN_V2_LOGS=
FILEBASE_TOKEN_ATLAS_LOGS=
FILEBASE_TOKEN_KLEROS_SCOUT=

# Location of logs. By defult it uses /var/log/py-kleros-ipfs
LOG_FILEPATH=

# The Graph gateway API key. Required by delete_poh_user_data.py: the
# decentralized gateway rejects unauthenticated queries.
GRAPH_API_KEY=

# Optional override for the Proof of Humanity v2 core subgraph. Defaults to the
# mainnet one, which also indexes the legacy v1 registrations.
POH_SUBGRAPH_ID=

# BetterStack heartbeat URL (optional). If set, a GET request is sent on successful backup.
BETTERSTACK_HEARTBEAT_URL=